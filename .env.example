# Copy to .env and fill in. Free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: which model(s) to use, overriding [llm] models in config.toml.
# Comma-separated; the first is preferred and the rest are fallbacks if it is rate-limited or down.
# See what is free right now:  python -m companyfinder models     Compare them:  python -m companyfinder bench
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free
